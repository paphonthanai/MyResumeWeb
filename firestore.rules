rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Blog posts: anyone can read published posts. Writes (create/update/
    // delete, and reading drafts) are restricted to the single admin
    // account by email — NOT just "any signed-in user" — because the
    // Firebase Web API key is public by nature, so anyone could otherwise
    // self-register via the client SDK and satisfy `request.auth != null`.
    match /posts/{postId} {
      allow read: if (resource != null && resource.data.published == true)
                   || (request.auth != null && request.auth.token.email.lower() == "pj06052538@gmail.com");
      allow write: if request.auth != null
                    && request.auth.token.email.lower() == "pj06052538@gmail.com";
    }

    // Project inquiries from the public contact form: anyone may create one
    // (with strict shape/size limits to blunt spam), but only the admin can
    // read, change or delete them.
    match /inquiries/{inquiryId} {
      allow create: if request.resource.data.keys().hasOnly(
                         ['name', 'contact', 'package', 'message', 'lang', 'createdAt'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 100
                    && request.resource.data.contact is string
                    && request.resource.data.contact.size() > 0
                    && request.resource.data.contact.size() <= 150
                    && request.resource.data.message is string
                    && request.resource.data.message.size() > 0
                    && request.resource.data.message.size() <= 2000
                    && request.resource.data.package in ['', 'starter', 'pro', 'enterprise',
                         // Website Builder plans (src/views/WebsiteBuilderView.vue)
                         'site-free', 'site-light', 'site-core', 'site-business', 'site-elite', 'site-setup']
                    && request.resource.data.lang in ['th', 'en']
                    && request.resource.data.createdAt == request.time;
      allow read, update, delete: if request.auth != null
                    && request.auth.token.email.lower() == "pj06052538@gmail.com";
    }

    // ---- Website Builder (src/app) ----
    // Any visitor may sign up, so every rule below is scoped to the signed-in
    // user's own documents. Plan and publish status can't be changed from
    // the browser; those will move through a trusted backend later.

    function signedIn() { return request.auth != null; }
    function optStr(d, k, max) { return !(k in d) || (d[k] is string && d[k].size() <= max); }
    function ownsTenant(tid) {
      return signedIn()
        && get(/databases/$(database)/documents/tenants/$(tid)).data.ownerUid == request.auth.uid;
    }
    function validTenant(d) {
      return d.keys().hasOnly(['ownerUid', 'plan', 'requestedPlan', 'businessType', 'name', 'address',
               'phone', 'line', 'domain', 'langs', 'template', 'color', 'onboarding', 'status',
               'createdAt', 'updatedAt'])
        && d.ownerUid == request.auth.uid
        && d.template == 'poster'
        && d.onboarding in [2, 3, 4, 'done']
        && d.updatedAt == request.time
        && (!('requestedPlan' in d) || d.requestedPlan == null
            || d.requestedPlan in ['site-free', 'site-light', 'site-core', 'site-business', 'site-elite'])
        && (!('businessType' in d) || d.businessType in ['food', 'health', 'industry', 'safety',
            'construction', 'professional', 'education', 'travel'])
        && (!('name' in d) || (d.name is map && d.name.keys().hasOnly(['th', 'en'])
            && d.name.th is string && d.name.th.size() <= 160
            && d.name.en is string && d.name.en.size() <= 160))
        && optStr(d, 'address', 300) && optStr(d, 'phone', 20)
        && optStr(d, 'line', 40) && optStr(d, 'domain', 100)
        && (!('langs' in d) || d.langs == ['th'] || d.langs == ['th', 'en'])
        && (!('color' in d) || (d.color is string && d.color.matches('^#[0-9a-fA-F]{6}$')));
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      // tenantId must point at a website this user owns (checked after the
      // batch that creates both documents).
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'displayName', 'tenantId', 'createdAt', 'updatedAt'])
        && getAfter(/databases/$(database)/documents/tenants/$(request.resource.data.tenantId)).data.ownerUid == request.auth.uid;
      allow delete: if false;
    }

    match /tenants/{tid} {
      allow read: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if signedIn() && validTenant(request.resource.data)
        && request.resource.data.plan == 'free'
        && request.resource.data.status == 'draft'
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && resource.data.ownerUid == request.auth.uid
        && validTenant(request.resource.data)
        && request.resource.data.plan == resource.data.plan
        && request.resource.data.status == resource.data.status
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;

      match /pages/{pageId} {
        allow read: if ownsTenant(tid);
        allow create, update: if ownsTenant(tid)
          && request.resource.data.keys().hasOnly(['name', 'path', 'order', 'status', 'createdAt'])
          && request.resource.data.status == 'draft'
          && request.resource.data.order is int;
        allow delete: if false;
      }
    }

    // Everything else is closed by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
